{
  "name": "@use-q/api-client-react",
  "version": "0.1.0",
  "description": "Opinionated TanStack Query v5 hooks for use-q (useQ, useM, …).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rithviknishad/use-q.git",
    "directory": "packages/api-client-react"
  },
  "homepage": "https://use-q.dev",
  "bugs": {
    "url": "https://github.com/rithviknishad/use-q/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@use-q/api-client": "^0.1.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@use-q/api-client": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
